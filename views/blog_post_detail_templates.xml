<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Các khối bên cạnh bài viết. Mặc định TẮT; admin bật/tắt trong
         editor > Kiểu > "Blog Page" (xem hami_blog_options.xml). -->

    <!-- Khối đỏ "Đăng ký hội viên" trong thanh bên (cần bật "Thanh bên") -->
    <template id="opt_hami_cta_display" name="HAMI: Đăng ký hội viên"
              inherit_id="website_blog.blog_post_sidebar" active="False" priority="0">
        <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
            <!-- Vùng oe_structure: nội dung mặc định bên dưới được lưu vào trang ở lần
                 sửa đầu tiên, sau đó admin chỉnh Nền/chữ/nút như một khối thường. -->
            <div class="oe_structure mb-4" id="oe_structure_hami_cta">
                <section class="hami_cta s_hami_cta" data-name="Đăng ký hội viên">
                    <p class="hami_cta_eyebrow">Hội viên HAMI</p>
                    <h2 class="hami_cta_title">ĐĂNG KÝ HỘI VIÊN</h2>
                    <p>Kết nối cùng cộng đồng doanh nghiệp sản xuất sản phẩm công nghiệp chủ lực Hà Nội.</p>
                    <a href="/dang-ky-hoi-vien" class="hami_cta_btn">Đăng ký ngay <i class="fa fa-angle-right" role="img" aria-hidden="true"/></a>
                </section>
            </div>
        </xpath>
    </template>

    <!-- Hộp "Xem nhiều" trong thanh bên (cần bật "Thanh bên") -->
    <template id="opt_hami_most_viewed_display" name="HAMI: Xem nhiều"
              inherit_id="website_blog.blog_post_sidebar" active="False" priority="0">
        <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
            <section class="hami_box mb-4">
                <h2 class="hami_box_title">XEM NHIỀU</h2>
                <t t-set="posts" t-value="request.env['blog.post'].hami_most_viewed(-1, 5)"/>
                <t t-set="show_date" t-value="True"/>
                <t t-call="hami_blog.most_viewed_body"/>
            </section>
        </xpath>
    </template>

</odoo>
