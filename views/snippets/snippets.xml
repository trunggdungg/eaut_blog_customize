<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hami_blog_snippets" inherit_id="website.snippets" name="HAMI Blog snippets">
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t snippet-group="hami_blog" t-snippet="website.s_snippet_group" string="Tin tức HAMI"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_blog_posts.svg"/>
            <t t-snippet="hami_blog.s_hami_activities" string="Hoạt động HAMI" group="hami_blog"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_blog_posts.svg"/>
            <t t-snippet="hami_blog.s_hami_news_blocks" string="Tin tức theo thể loại" group="hami_blog"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_blog_posts.svg"/>
            <t t-snippet="hami_blog.s_hami_most_viewed" string="Xem nhiều" group="hami_blog"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_blog_posts.svg"/>
            <t t-snippet="hami_blog.s_hami_cta" string="Đăng ký hội viên" group="hami_blog"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_blog_posts.svg"/>
        </xpath>
    </template>
</odoo>
