<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hami_blog_snippets" inherit_id="website.snippets" name="HAMI Blog snippets">
        <!-- Nhóm (hiện ở cột trái hộp thoại "Chèn một khối"): thuộc snippet_groups -->
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t snippet-group="hami_blog" t-snippet="website.s_snippet_group" string="Tin tức HAMI"
               t-thumbnail="/hami_blog/static/src/img/snippets_thumbs/s_hami_group.svg"/>
        </xpath>
        <!--
            Các khối phải nằm trong snippet_structure. Không neo vào blog_posts_hook
            vì website_blog đã `replace` phần tử đó (hook không còn tồn tại).
        -->
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="hami_blog.s_hami_activities" string="Hoạt động HAMI" group="hami_blog"
               t-thumbnail="/hami_blog/static/src/img/snippets_thumbs/s_hami_activities.svg"/>
            <t t-snippet="hami_blog.s_hami_news_blocks" string="Tin tức theo thể loại" group="hami_blog"
               t-thumbnail="/hami_blog/static/src/img/snippets_thumbs/s_hami_news_blocks.svg"/>
        </xpath>
    </template>
</odoo>
